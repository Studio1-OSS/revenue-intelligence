NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to production on a public non-Vercel deployment; Vercel uses VERCEL_ENV.
APP_ENV=development
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate independently with openssl rand -hex 32
AUTH0_SECRET=
# Required for external MCP bearer tokens. Register this API in Auth0.
AUTH0_AUDIENCE=
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Exactly 64 hex characters, distinct from AUTH0_SECRET
KEY_ENCRYPTION_SECRET=
CRON_SECRET=
# AI models are selected per workspace. No shared NEBIUS_API_KEY is used.
